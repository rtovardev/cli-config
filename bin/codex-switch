#!/usr/bin/env python3
import sys
import os
import json
import subprocess

HOME = os.path.expanduser("~")
CODEX_LINK = os.path.join(HOME, ".codex")
PROFILES_DIR = os.path.join(HOME, ".codex-profiles")

def get_auth_info(profile_dir):
    auth_file = os.path.join(profile_dir, "auth.json")
    if not os.path.exists(auth_file):
        return None
    try:
        with open(auth_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        tokens = data.get("tokens") or {}
        id_token = tokens.get("id_token", "")
        claims = {}
        if "." in id_token:
            payload_b64 = id_token.split(".")[1]
            rem = len(payload_b64) % 4
            if rem:
                payload_b64 += "=" * (4 - rem)
            import base64
            claims = json.loads(base64.urlsafe_b64decode(payload_b64.encode()).decode())
        openai = claims.get("https://api.openai.com/auth") or {}
        email = claims.get("email") or "desconocido"
        plan = openai.get("chatgpt_plan_type") or data.get("auth_mode") or "plan"
        return {"email": email, "plan": plan}
    except Exception:
        return None

def get_active_profile():
    if os.path.islink(CODEX_LINK):
        target = os.readlink(CODEX_LINK)
        return os.path.basename(target)
    return "desconocido"

def status():
    active = get_active_profile()
    print("\n📦 Perfiles de Codex (Aislamiento Total de Directorio):")
    profiles = [d for d in os.listdir(PROFILES_DIR) if os.path.isdir(os.path.join(PROFILES_DIR, d))]
    for p in sorted(profiles):
        p_dir = os.path.join(PROFILES_DIR, p)
        auth = get_auth_info(p_dir)
        is_active = (p == active)
        marker = "▶ (ACTIVO)" if is_active else " "
        if auth:
            print(f"  {marker:10} {p:<10} → {auth['email']} ({auth['plan']})")
        else:
            print(f"  {marker:10} {p:<10} → [Pendiente de login: codex-switch {p}]")
    print()

def switch_to(profile_name):
    target_dir = os.path.join(PROFILES_DIR, profile_name)
    if not os.path.exists(target_dir):
        print(f"Error: El perfil '{profile_name}' no existe en {PROFILES_DIR}")
        sys.exit(1)

    # Update symlink
    if os.path.islink(CODEX_LINK) or not os.path.exists(CODEX_LINK):
        try:
            os.remove(CODEX_LINK)
        except FileNotFoundError:
            pass
        os.symlink(target_dir, CODEX_LINK)
    else:
        # It was a real dir, move it
        backup = CODEX_LINK + ".orig"
        os.rename(CODEX_LINK, backup)
        os.symlink(target_dir, CODEX_LINK)

    # Check if logged in
    auth = get_auth_info(target_dir)
    if auth:
        print(f"✓ Cambiado exitosamente a Codex '{profile_name}' ({auth['email']} · {auth['plan']})")
    else:
        print(f"El perfil '{profile_name}' aún no tiene sesión iniciada.")
        print(f"Iniciando login para '{profile_name}' en su directorio aislado...")
        subprocess.run(["codex", "login"])
        auth_after = get_auth_info(target_dir)
        if auth_after:
            print(f"✓ Perfil '{profile_name}' registrado exitosamente: {auth_after['email']}")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("status", "ls", "list"):
        status()
    elif sys.argv[1] in ("mart", "trabajo"):
        switch_to("mart")
    elif sys.argv[1] in ("personal", "home"):
        switch_to("personal")
    else:
        switch_to(sys.argv[1])

if __name__ == "__main__":
    main()
