# Brewfile — Stack de herramientas de terminal y CLI

# Gestor de historial con SQLite y sincronización
brew "atuin"

# Interfaz TUI para Git
brew "lazygit"

# Interfaz TUI para Docker y Docker Compose
brew "lazydocker"

# Terminal Text Tool (Editor IDE en terminal)
brew "ttt"

# GitHub CLI
brew "gh"

# Motor de prompt personalizable
tap "jandedobbeleer/oh-my-posh"
brew "jandedobbeleer/oh-my-posh/oh-my-posh"

# Navegador web nativo para terminal (gráficos Kitty e integración de agentes)
cask "terminal-browser"
